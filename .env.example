# id42-agent settings. Copy to .env. These names belong to this distribution.
# Bootstrap renders them into nanobot config.json on the first run only.
# Later edits in the WebUI are left alone. See docs/architecture.md for the
# upstream keys that receive these values.

# IANA timezone written to agents.defaults.timezone.
TZ=America/Sao_Paulo

# OpenAI-compatible base URL reachable from the gateway container.
# host.docker.internal is the Docker host (extra_hosts in docker-compose.yml).
# Do not use localhost here: inside the container that is the container itself.
# The path must be /v1 (nanobot's Ollama default).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Model name as listed by Ollama, for example llama3.2. Required before init.
OLLAMA_MODEL=

# true writes channels.telegram. false leaves Telegram out of the first config.
TELEGRAM_ENABLED=false

# From BotFather. Required when TELEGRAM_ENABLED=true. Never commit a real token.
# The first config stores ${TELEGRAM_BOT_TOKEN}, not this value.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids or usernames, without @.
# Required when TELEGRAM_ENABLED=true. The value * is rejected.
# Example: 123456789
TELEGRAM_ALLOWED_USERS=

# WebUI password. The first config stores ${NANOBOT_WEB_TOKEN}, not this value.
# This nanobot pin has no file field for that password. The gateway reads it
# from the environment at startup. Leave empty and scripts/bootstrap.sh
# generates one into .env without printing it.
NANOBOT_WEB_TOKEN=

# true writes tools.mcpServers.id42-work. false leaves the MCP server out of
# the first config. The server is stdio inside the gateway container. It does
# not listen on a port. See docs/id42-work.md.
ID42_WORK_ENABLED=false

# module:callable for `id42-work mcp serve --factory`. Empty uses
# id42_agent.mcp_host:server (SQLite on the id42-work-data volume, with
# echo, note, and note.list). The empty in-memory factory is
# id42_agent.mcp_stub:server.
# Example: myapp.governed:server
ID42_WORK_FACTORY=

# Optional colon-separated absolute paths inside the container. The rendered
# PYTHONPATH always starts with /opt/id42-agent. Empty uses only that path.
# Do not point this at the agent workspace.
ID42_WORK_PYTHONPATH=

# Absolute path of the HMAC key file inside the container. Empty uses
# /var/lib/id42-work/authority.key on the id42-work-data volume. The file is
# created on first use, mode 0600. A relative path is rejected. Do not point
# this at the agent workspace. When set, the first init copies it into the
# MCP server env. An existing config.json is not rewritten.
# ID42_WORK_AUTHORITY_KEY_PATH=/var/lib/id42-work/authority.key

# Storage for the default factory. sqlite (the default) uses the file on
# id42-work-data. postgres uses the postgres Compose profile and
# PostgresStorage. Set this before the first init when ID42_WORK_ENABLED=true.
# An existing config.json is not rewritten. The operator scripts read the
# value from this file on each run.
ID42_WORK_STORAGE=sqlite

# libpq URL or connection string. Required when ID42_WORK_STORAGE=postgres
# unless ID42_WORK_DATABASE_URL_FILE is set. The password is a secret. Never
# commit a real one. Compose expands $, so write a literal $ in the password
# as $$. The host name postgres is the Compose service. It is not published
# on the host. A new config stores a file path, not this URL. When this value
# is set and the file variable is empty, startup writes it to
# /var/lib/id42-work/secrets/database.url mode 0600.
# Prefer the file. Doctor warns while this inline value is set.
# Example: postgresql://id42:change-me@postgres:5432/id42_work
ID42_WORK_DATABASE_URL=
# ID42_WORK_DATABASE_URL_FILE=/var/lib/id42-work/secrets/database.url

# Used only by the postgres profile. Leave the password empty until you
# enable that profile. These names are not nanobot settings.
ID42_POSTGRES_USER=id42
ID42_POSTGRES_PASSWORD=
ID42_POSTGRES_DB=id42_work

# Build arg for the id42-work git commit. Not a nanobot setting. Uncomment and
# set a full commit SHA, then rebuild. The default is the pin in docker-compose.yml.
# ID42_WORK_REF=ae07623aa67c0b5d0535cb58f6a2e2b204736e50
# ID42_WORK_ODOO_REF=3797544d8a3580657548d000110915578efe87c3
# ID42_WORK_GITHUB_REF=2e2a23d8f64d6c2313523bbf7ee24554fb3a4cb3

# Odoo and GitHub connectors. Default off. The three built-in works stay as
# they are. true registers the connector works in the default factory.
# Prefer a mode 0600 file. A new config stores the file path, never the
# secret. An inline value with no file is written at startup to
# /var/lib/id42-work/secrets/odoo.key or github.token, mode 0600.
# Doctor warns while the inline value is set. Never commit a real key or token.
ID42_WORK_ODOO_ENABLED=false
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
# ODOO_API_KEY_FILE=/var/lib/id42-work/odoo.key
# ODOO_PROTOCOL=jsonrpc
# ODOO_TIMEOUT=20
# Comma-separated technical model names. Required when Odoo is enabled.
# ID42_WORK_ODOO_READ_MODELS=res.partner
# Write models must also be in the read list. Empty skips odoo.create.
# ID42_WORK_ODOO_WRITE_MODELS=res.partner
# Optional field allow-list. model:field,field;model:field. name is required.
# ID42_WORK_ODOO_READ_FIELDS=res.partner:name

ID42_WORK_GITHUB_ENABLED=false
# Comma-separated owner/name. Required when GitHub is enabled. This is the
# only set of repositories the connector will call. There is no merge, close,
# delete, or push work.
# ID42_WORK_GITHUB_REPOSITORIES=acme/widgets
GITHUB_TOKEN=
# ID42_WORK_GITHUB_TOKEN_FILE=/var/lib/id42-work/github.token
# Operation log. Empty uses /var/lib/id42-work/github-operations.sqlite.
# ID42_WORK_GITHUB_OPERATION_LOG=/var/lib/id42-work/github-operations.sqlite

# Operator UI (profile id42-work-web). Not the nanobot WebUI. Empty leaves
# that profile unable to start. Set one of these. A set file path wins.
# The file must be mode 0600 inside the container, not a symlink.
# Never commit a real token. It is not written into config.json.
# The host port is published by id42-work-web-publish, on 127.0.0.1 only.
ID42_WORK_WEB_TOKEN=
# ID42_WORK_WEB_TOKEN_FILE=/var/lib/id42-work/web.token

# Host port for the operator UI. The container port stays 8767.
# The published address is 127.0.0.1. Do not change that bind.
# ID42_WORK_WEB_PUBLISH_PORT=8767

